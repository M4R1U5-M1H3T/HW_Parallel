{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MPI: build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20", "-O3",
                "main.cpp",
                "-o", "main.exe",
                "-I", "C:/Program Files (x86)/Microsoft SDKs/MPI/Include",
                "-L", "C:/Program Files (x86)/Microsoft SDKs/MPI/Lib/x64",
                "-lmsmpi"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "MPI: hello world (4 processes)",
            "type": "shell",
            "command": "g++ -std=c++20 hello_mpi.cpp -o hello_mpi.exe -I 'C:/Program Files (x86)/Microsoft SDKs/MPI/Include' -L 'C:/Program Files (x86)/Microsoft SDKs/MPI/Lib/x64' -lmsmpi; mpiexec -n 4 ./hello_mpi.exe",
            "problemMatcher": ["$gcc"]
        }
    ]
}
